# ==============================================================================
# HB Plus Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your Firebase & Google OAuth credentials.
# Values prefixed with EXPO_PUBLIC_ are embedded into the client bundle at build
# time. NEVER place private service account keys or administrative secrets here.
# ==============================================================================

# Firebase Web Client Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hbplus-auth.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hbplus-auth
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hbplus-auth.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google OAuth Client IDs (For Native Android/iOS Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-examplewebclientid.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-exampleiosclientid.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789012-exampleandroidclientid.apps.googleusercontent.com

# Domain Authorization & RBAC
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit
EXPO_PUBLIC_INITIAL_ADMIN_EMAIL=admin@hbplus.fit
